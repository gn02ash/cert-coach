  "components": {
    "schemas": {
      "AiCapabilities": {
        "required": [
          "chatProvider",
          "chatModel",
          "embeddingProvider",
          "embeddingModel",
          "chatAvailable",
          "semanticSearch"
        ],
        "type": "object",
        "properties": {
          "chatProvider": {
            "type": "string"
          },
          "chatModel": {
            "type": [
              "null",
              "string"
            ]
          },
          "embeddingProvider": {
            "type": "string"
          },
          "embeddingModel": {
            "type": "string"
          },
          "chatAvailable": {
            "type": "boolean"
          },
          "semanticSearch": {
            "type": "boolean"
          }
        }
      },
      "AuthProvider": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CapacityShortfall": {
        "required": [
          "missingSessions",
          "suggestedHoursPerWeek",
          "suggestedExamDate"
        ],
        "type": "object",
        "properties": {
          "missingSessions": {
            "type": "integer",
            "format": "int32"
          },
          "suggestedHoursPerWeek": {
            "type": "number",
            "format": "double"
          },
          "suggestedExamDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CertificationDetail": {
        "required": [
          "id",
          "examCode",
          "name",
          "vendor",
          "status",
          "replacedByExamCode",
          "outlineUrl",
          "outlineVersionDate",
          "activePlanId",
          "domains"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "examCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CertificationStatus"
          },
          "replacedByExamCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "outlineUrl": {
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          },
          "outlineVersionDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "activePlanId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "domains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DomainView"
            }
          }
        }
      },
      "CertificationStatus": {
        "enum": [
          "Active",
          "Beta",
          "Retired",
          "Replaced"
        ]
      },
      "CertificationSummary": {
        "required": [
          "id",
          "examCode",
          "name",
          "vendor",
          "status",
          "replacedByExamCode",
          "domainCount",
          "objectiveCount",
          "activePlanId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "examCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CertificationStatus"
          },
          "replacedByExamCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "domainCount": {
            "type": "integer",
            "format": "int32"
          },
          "objectiveCount": {
            "type": "integer",
            "format": "int32"
          },
          "activePlanId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "DashboardView": {
        "required": [
          "today",
          "plans"
        ],
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date"
          },
          "plans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanDashboard"
            }
          }
        }
      },
      "DayOfWeek": {
        "enum": [
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ]
      },
      "DocumentStatus": {
        "enum": [
          "Pending",
          "Processing",
          "Ready",
          "Failed"
        ]
      },
      "DocumentSummary": {
        "required": [
          "id",
          "title",
          "fileName",
          "sizeBytes",
          "status",
          "error",
          "pageCount",
          "chunkCount",
          "certificationId",
          "examCode",
          "createdAt",
          "processedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "pageCount": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "chunkCount": {
            "type": "integer",
            "format": "int32"
          },
          "certificationId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "examCode": {
            "type": [
              "null",
              "string"
