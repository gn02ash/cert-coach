# Copy to .env to override the defaults in docker-compose.yml. Never commit .env.
# Everything is optional: with no .env the app runs locally with the dev login.

# Port the app is served on: http://localhost:8080
WEB_PORT=8080

# Local database. The container is reachable only from this machine.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# One-click local sign-in. Turn it off if the app is reachable by anyone else.
AUTH_DEV_LOGIN=true

# Microsoft Entra ID app registration (redirect URI: http://localhost:8080/signin-oidc)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Google OAuth client (redirect URI: http://localhost:8080/signin-google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers. With none set, the app runs in offline mode: search matches words only and
# answers are quoted passages. Keys stay in .env, which git ignores.
#
# Answers: Offline | Anthropic | AzureOpenAI | OpenAICompatible
AI_CHAT_PROVIDER=Offline
# Anthropic defaults to claude-opus-5-5. For Azure OpenAI, the deployment name.
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
# Azure OpenAI resource (https://<name>.openai.azure.com) or an OpenAI-compatible base URL.
AI_CHAT_ENDPOINT=

# Embeddings: Offline | AzureOpenAI | OpenAICompatible (Anthropic has no embeddings API).
# Vectors are stored at 1536 dimensions; text-embedding-3-small and -large both fit.
AI_EMBEDDINGS_PROVIDER=Offline
# Azure OpenAI deployment name, for example text-embedding-3-small.
AI_EMBEDDINGS_MODEL=
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_ENDPOINT=

# Optional: a YouTube Data API v3 key, to list videos per objective on the Resources page.
# Without it the page shows a YouTube search link instead. Each search uses 100 of the 10,000 free daily units.
YOUTUBE_API_KEY=

# Monthly AI allowance per learner. Leave off when only you use the app: you pay your own model bill.
# Turn it on before letting other people use an instance whose AI bill you pay. A unit is one input token,
# and an output token counts as 5 (Claude's price ratio). The defaults cap a Free learner at about $0.40
# a month and a Pro learner at about $6 on Claude Opus 5.5.
BILLING_ENABLED=false
BILLING_FREE_MONTHLY_UNITS=100000
BILLING_PRO_MONTHLY_UNITS=1500000
